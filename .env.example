# ── LLM（擇一）──────────────────────────────
LLM_PROVIDER=anthropic          # anthropic | openai | ollama | custom
LLM_MODEL=claude-sonnet-4-6

ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=              # 用 Groq / LM Studio / OpenRouter 等相容服務時填
# OLLAMA_BASE_URL=http://localhost:11434/v1

# ── SearXNG ─────────────────────────────────
SEARXNG_URL=http://localhost:8080
SEARXNG_ENGINES=google,bing,duckduckgo,brave
SEARXNG_LANGUAGE=zh-TW
SEARCH_DELAY=0.8                # 查詢間隔秒數，避免被 Google 限流

# ── 管線 ────────────────────────────────────
MAX_ROUNDS=3
QUERIES_PER_ROUND=10
MAX_PAGES_TO_SCRAPE=12
SCRAPE_MAX_CHARS=6000
RESPECT_ROBOTS=1

# 需登入或反爬、只用搜尋摘要的網域（逗號分隔）
# SNIPPET_ONLY_DOMAINS=instagram.com,threads.net,facebook.com,x.com
